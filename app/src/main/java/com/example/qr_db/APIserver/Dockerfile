# Берем официальный образ Node.js
FROM node:18

# Создаем рабочую папку внутри контейнера
WORKDIR /app

# Копируем файлы со списком зависимостей
COPY package*.json ./

# Устанавливаем библиотеки
RUN npm install

# Копируем вообще все файлы твоего проекта (сервер, роуты и т.д.)
COPY . .

# Открываем порт 3000 (как в твоем server.js)
EXPOSE 3000

# Команда для запуска сервера
CMD ["node", "server.js"]